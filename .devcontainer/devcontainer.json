{
  "name": "Accord Integration Platform",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "runServices": [
    "app",
    "postgres",
    "clickhouse",
    "prometheus",
    "grafana"
  ],
  "workspaceFolder": "/workspaces/accord",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest",
      "installGoTools": true
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/devcontainers-extra/features/go-task:1": {},
    "ghcr.io/devcontainers-extra/features/direnv:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      "packages": "postgresql-client"
    },
    "ghcr.io/nullcoder/devcontainer-features/stripe-cli:1": {}
  },
  "postCreateCommand": "test -x .venv/bin/python || uv venv .venv",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "UV_LINK_MODE": "copy"
  },
  "forwardPorts": [
    8000,
    8080,
    "grafana:3000",
    "prometheus:9090",
    "clickhouse:8123",
    "postgres:5432"
  ],
  "portsAttributes": {
    "8000": {
      "label": "Integration API",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Webhook Gateway",
      "onAutoForward": "notify"
    },
    "grafana:3000": {
      "label": "Grafana",
      "onAutoForward": "silent"
    },
    "prometheus:9090": {
      "label": "Prometheus",
      "onAutoForward": "silent"
    },
    "clickhouse:8123": {
      "label": "ClickHouse HTTP",
      "onAutoForward": "silent"
    },
    "postgres:5432": {
      "label": "PostgreSQL (dev container)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-containers",
        "ms-ossdata.vscode-pgsql",
        "redhat.vscode-yaml",
        "task.vscode-task",
        "openai.chatgpt"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "[go]": {
          "editor.defaultFormatter": "golang.Go",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
          }
        },
        "go.useLanguageServer": true,
        "go.toolsManagement.autoUpdate": true,
        "gopls": {
          "ui.semanticTokens": true
        },
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.diagnosticMode": "workspace",
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.ruff_cache": true
        }
      }
    }
  }
}
